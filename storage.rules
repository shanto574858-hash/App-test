rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.uid == 'aaWqMj9EgnWbZbX3skVUMOgpgRq2';
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.status == 'active'
      );
    }

    function hasPermission(perm) {
      return isSuperAdmin() || (
        isAdmin() &&
        perm in firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.permissions
      );
    }

    // Uploaded PDFs: only authorized admins can read/upload/delete (max 50MB, PDF content type)
    match /pdfs/{uploaderId}/{pdfId}/{fileName} {
      allow read: if isAdmin();
      allow write: if hasPermission('pdf_upload')
                   && request.auth.uid == uploaderId
                   && request.resource != null
                   && request.resource.size <= 50 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
      allow delete: if hasPermission('pdf_delete');
    }

    // User profile images: only owner can upload/update (max 5MB, image/*), authenticated users can view
    match /profiles/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
                   && request.auth.uid == userId
                   && request.resource != null
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }
  }
}
